generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model User {
  id               String             @id
  name             String             @db.Text
  email            String             @unique
  emailVerified    Boolean            @default(false)
  image            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  banExpires       DateTime?
  banReason        String?            @db.Text
  banned           Boolean?           @default(false)
  role             String?            @db.Text
  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  spk              SPK[]
  designFiles      DesignFile[]
  penerimaanBarang PenerimaanBarang[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  impersonatedBy String?  @db.Text
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Category {
  id        String    @id
  nama      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([nama(length: 191)])
  @@map("category")
}

model Unit {
  id        String      @id
  nama      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  products  Product[]
  bahanBaku BahanBaku[]

  @@index([nama(length: 191)])
  @@map("unit")
}

model Product {
  id         String      @id
  categoryId String
  unitId     String
  sku        String      @unique
  nama       String      @db.Text
  image      String?     @db.Text
  hpp        Decimal     @db.Decimal(10, 2)
  hargaJual  Decimal     @db.Decimal(10, 2)
  stok       Decimal?    @db.Decimal(10, 2)
  minStok    Decimal?    @db.Decimal(10, 2)
  isService  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([sku(length: 191)])
  @@index([nama(length: 191)])
  @@map("product")
}

model CostCategory {
  id         String   @id
  nama       String   @db.Text
  jenisBeban String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  costs      Cost[]

  @@index([nama(length: 191)])
  @@map("cost_category")
}

model Cost {
  id             String       @id
  costCategoryId String
  nama           String       @db.Text
  nominal        Decimal      @db.Decimal(10, 2)
  keterangan     String       @db.Text
  buktiNota      String       @db.Text
  tanggal        DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Cascade)

  @@index([nama(length: 191)])
  @@map("cost")
}

model Customer {
  id        String   @id
  nama      String   @db.Text
  nomorHp   String   @db.Text
  image     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([nama(length: 191)])
  @@map("customer")
}

model Supplier {
  id         String             @id
  nama       String             @db.Text
  nomorHp    String             @db.Text
  email      String?            @db.Text
  image      String?            @db.Text
  alamat     String?            @db.Text
  keterangan String?            @db.Text
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  penerimaan PenerimaanBarang[]

  @@index([nama(length: 191)])
  @@map("supplier")
}

model BahanBaku {
  id         String      @id
  unitId     String
  nama       String      @db.Text
  stok       Decimal     @default(0) @db.Decimal(10, 2)
  minStok    Decimal?    @db.Decimal(10, 2)
  keterangan String?     @db.Text
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  stokMasuk  StokMasuk[]

  @@index([nama(length: 191)])
  @@index([unitId])
  @@map("bahan_baku")
}

model PenerimaanBarang {
  id           String   @id
  nomorFaktur  String?  @db.VarChar(100)
  supplierId   String?
  tanggal      DateTime @default(now())
  keterangan   String?  @db.Text
  buktiNota    String?  @db.Text
  totalTagihan Decimal  @default(0) @db.Decimal(12, 2)
  addedById    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  addedBy  User?       @relation(fields: [addedById], references: [id], onDelete: SetNull)
  items    StokMasuk[]

  @@index([supplierId])
  @@index([addedById])
  @@index([tanggal])
  @@map("penerimaan_barang")
}

model StokMasuk {
  id             String   @id
  penerimaanId   String
  bahanBakuId    String
  jumlah         Decimal  @db.Decimal(10, 2)
  hargaSatuan    Decimal? @db.Decimal(10, 2)
  totalHargaItem Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  penerimaan PenerimaanBarang @relation(fields: [penerimaanId], references: [id], onDelete: Cascade)
  bahanBaku  BahanBaku        @relation(fields: [bahanBakuId], references: [id], onDelete: Restrict)

  @@index([penerimaanId])
  @@index([bahanBakuId])
  @@map("stok_masuk")
}

model Order {
  id               String           @id
  customerId       String
  nomorOrder       String           @unique @db.VarChar(50)
  channel          OrderChannel     @default(LANGSUNG)
  statusProduksi   StatusProduksi   @default(PENDING)
  statusPembayaran StatusPembayaran @default(BELUM_BAYAR)
  metodePembayaran MetodePembayaran @default(TUNAI)
  deadline         DateTime?
  catatan          String?          @db.Text
  subtotal         Decimal          @db.Decimal(12, 2)
  diskon           Decimal          @default(0) @db.Decimal(12, 2)
  ongkir           Decimal?         @db.Decimal(12, 2)
  grandTotal       Decimal          @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  designFiles      DesignFile[]
  spk              SPK?
  user             User?            @relation(fields: [userId], references: [id])
  userId           String?

  @@index([customerId])
  @@index([nomorOrder])
  @@map("order")
}

model OrderItem {
  id        String   @id
  orderId   String
  productId String
  nama      String   @db.Text
  harga     Decimal  @db.Decimal(12, 2)
  qty       Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  catatan   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model DesignFile {
  id           String   @id
  orderId      String
  nama         String   @db.Text
  filePath     String   @db.Text
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("design_file")
}

model Karyawan {
  id        String   @id
  nama      String   @db.Text
  nomorHp   String?  @db.Text
  posisi    String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spk       SPK[]

  @@index([nama(length: 191)])
  @@map("karyawan")
}

model SPK {
  id            String         @id
  orderId       String         @unique
  karyawanId    String
  tahapProduksi StatusProduksi
  model         String?        @db.Text
  tali          String?        @db.Text
  ukuran        String?        @db.Text
  jumlah        Decimal        @db.Decimal(10, 2)
  catatan       String?        @db.Text
  tanggalSetor  DateTime?
  accCetak      Boolean        @default(false)
  accCetakAt    DateTime?
  accCetakOleh  String?        @db.Text
  statusSPK     StatusSPK      @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  karyawan Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id])
  userId   String?

  @@index([karyawanId])
  @@index([tahapProduksi])
  @@map("spk")
}

// Enums
enum StatusSPK {
  DRAFT
  AKTIF
  SELESAI
  REVISI
  BATAL
}

enum OrderChannel {
  LANGSUNG
  WHATSAPP
  INSTAGRAM
  MARKETPLACE
  WEBSITE
  LAINNYA
}

enum StatusProduksi {
  PENDING
  DESAIN
  POTONG
  SABLON
  JAHIT
  PACKING
  SELESAI
  BATAL
}

enum StatusPembayaran {
  BELUM_BAYAR
  DP
  LUNAS
  REFUND
}

enum MetodePembayaran {
  TUNAI
  TRANSFER
  QRIS
  KREDIT
  LAINNYA
}
