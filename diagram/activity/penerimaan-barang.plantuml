@startuml AD_TerimaBarang
skinparam activity {
  BackgroundColor #EDE7F6
  BorderColor #6A1B9A
  DiamondBackgroundColor #FFF3E0
}

start
:Staff membuka menu Penerimaan Barang;
:Klik "Tambah Penerimaan Baru";

:Pilih Supplier;
:Isi nomor faktur & tanggal penerimaan;

if (Ada bukti nota / faktur fisik?) then (ya)
  :Foto / scan dan upload bukti nota;
endif

:Tambahkan item bahan baku yang diterima;
repeat
  :Pilih Bahan Baku dari daftar;
  :Input jumlah yang diterima;
  :Input harga beli per satuan;
  :Sistem hitung total harga item;
repeat while (Tambah item lagi?) is (ya)

:Sistem menghitung total tagihan keseluruhan;
:Review data penerimaan;

if (Data sudah benar?) then (tidak)
  :Kembali perbaiki isian;
  stop
endif

:Submit form;
:Simpan record PenerimaanBarang ke database;

fork
  :Simpan setiap item sebagai StokMasuk;
  :Tambahkan jumlah ke stok BahanBaku;
fork again
  :Buat entri Jurnal — Debet: Persediaan Bahan;
  :Buat entri Jurnal — Kredit: Hutang Dagang / Kas;
end fork

:Tampilkan detail penerimaan yang berhasil disimpan;

stop
@enduml
