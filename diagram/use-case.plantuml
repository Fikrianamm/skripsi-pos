@startuml UseCase_POS
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkOrange
}

actor "Administrator" as Admin   #CC0000
actor "Kasir"          as Kasir  #E65100
actor "Desainer"       as Des    #1565C0
actor "Produksi"       as Prod   #2E7D32
actor "Gudang"         as Gudang #6A1B9A

rectangle "Sistem POS Web" {

  package "Autentikasi" {
    (Login) as UC_Login
    (Kelola Pengguna) as UC_User
  }

  package "Data Master" {
    (Kelola Produk)      as UC_Produk
    (Kelola Customer)    as UC_Cust
    (Kelola Supplier)    as UC_Sup
    (Kelola Karyawan)    as UC_Kary
    (Kelola Bahan Baku)  as UC_BB
  }

  package "Manajemen Order" {
    (Buat Order Baru)        as UC_BuatOrder
    (Tambah Customer Baru)   as UC_NewCust
    (Lihat Daftar Order)     as UC_ListOrder
    (Update Status Order)    as UC_Status
    (Upload File Desain)     as UC_Desain
    (Buat SPK)               as UC_SPK
    (Catat Pembayaran Order) as UC_Bayar
    (Upload Bukti Nota)      as UC_Nota
  }

  package "Produksi & Gudang" {
    (Update Tahap Produksi)        as UC_UpdateSPK
    (Catat Pengeluaran Bahan Baku) as UC_KeluarBB
    (Catat Penerimaan Barang)      as UC_Terima
  }

  package "Keuangan & Laporan" {
    (Kelola Jurnal Umum)      as UC_Jurnal
    (Kelola Chart of Account) as UC_COA
    (Kelola Kas & Bank)       as UC_KasBank
    (Lihat Data Piutang)      as UC_Piutang
    (Laporan Laba Rugi)       as UC_LR
    (Laporan Neraca)          as UC_Neraca
    (Laporan Arus Kas)        as UC_ArusKas
    (Dashboard Analitik)      as UC_Dashboard
  }
}

' ─── Relasi <<include>> ───────────────────────────────────
UC_BuatOrder       .> UC_ListOrder  : <<include>>
UC_Bayar           .> UC_ListOrder  : <<include>>
UC_Desain          .> UC_ListOrder  : <<include>>
UC_SPK             .> UC_ListOrder  : <<include>>
UC_KeluarBB        .> UC_SPK        : <<include>>

' ─── Relasi <<extend>> ────────────────────────────────────
UC_NewCust  .> UC_BuatOrder : <<extend>>
UC_Nota     .> UC_Terima    : <<extend>>
UC_Desain   .> UC_Status    : <<extend>>
UC_SPK      .> UC_Status    : <<extend>>

' ─── Aktor : Administrator ────────────────────────────────
Admin --> UC_Login
Admin --> UC_User
Admin --> UC_Produk
Admin --> UC_Cust
Admin --> UC_Sup
Admin --> UC_Kary
Admin --> UC_BB
Admin --> UC_ListOrder
Admin --> UC_Jurnal
Admin --> UC_COA
Admin --> UC_KasBank
Admin --> UC_Piutang
Admin --> UC_LR
Admin --> UC_Neraca
Admin --> UC_ArusKas
Admin --> UC_Dashboard

' ─── Aktor : Kasir ────────────────────────────────────────
Kasir --> UC_Login
Kasir --> UC_BuatOrder
Kasir --> UC_Status
Kasir --> UC_Bayar

' ─── Aktor : Desainer ─────────────────────────────────────
Des --> UC_Login
Des --> UC_Desain
Des --> UC_Status

' ─── Aktor : Produksi ─────────────────────────────────────
Prod --> UC_Login
Prod --> UC_SPK
Prod --> UC_UpdateSPK

' ─── Aktor : Gudang ───────────────────────────────────────
Gudang --> UC_Login
Gudang --> UC_Terima
Gudang --> UC_KeluarBB

@enduml
