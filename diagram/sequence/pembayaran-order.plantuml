@startuml SD_Pembayaran
skinparam sequence {
  ActorBackgroundColor #E8F5E9
  ParticipantBackgroundColor #F3E5F5
  ArrowColor #2E7D32
}

actor "Staff" as Staff
participant "Browser\n(Next.js)" as UI
participant "API /api/order\n/[id]/payment" as API
participant "Auth" as Auth
database "Database\n(MySQL)" as DB

Staff -> UI : Buka halaman detail Order
UI --> Staff : Tampilkan informasi order & status pembayaran

Staff -> UI : Klik "Catat Pembayaran"
UI --> Staff : Tampilkan form pembayaran\n(nominal, metode, tanggal)

Staff -> UI : Isi data pembayaran\nlalu klik Submit

UI -> API : POST /api/order/[id]/payment\n{nominal, metodePembayaran, tanggal, keterangan}
activate API

API -> Auth : Verifikasi sesi pengguna
Auth --> API : Valid (userId)

API -> DB : SELECT order WHERE id = orderId
DB --> API : Data order (grandTotal, statusPembayaran)

API -> DB : SELECT akun WHERE kodeAkun = defaultPendapatan
DB --> API : akunPendapatanId

API -> DB : BEGIN TRANSACTION

API -> DB : INSERT payment\n{orderId, userId, nominal, metodePembayaran}
DB --> API : payment.id

note right of API
  Pencatatan Double-Entry:
  Debet  = Kas / Rekening Bank
  Kredit = Akun Pendapatan Penjualan
end note

API -> DB : INSERT jurnal_umum (sisi Debet)\n{akunDebetId, nominal, ref, paymentId}
DB --> API : jurnal Debet tersimpan

API -> DB : INSERT jurnal_umum (sisi Kredit)\n{akunKreditId, nominal, ref, paymentId}
DB --> API : jurnal Kredit tersimpan

API -> DB : SELECT SUM(nominal) FROM payment\nWHERE orderId = ? AND deletedAt IS NULL
DB --> API : totalBayar

alt totalBayar >= grandTotal
  API -> DB : UPDATE order SET statusPembayaran = LUNAS
else totalBayar > 0
  API -> DB : UPDATE order SET statusPembayaran = DP
end

API -> DB : COMMIT TRANSACTION
DB --> API : OK
deactivate API

API --> UI : 200 OK + data payment yang baru
UI --> Staff : Toast "Pembayaran berhasil dicatat"\nRefresh data order & riwayat pembayaran

@enduml
