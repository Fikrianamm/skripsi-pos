NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# DATABASE CONFIGURATION
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://root:password@localhost:3306/nextjs_starter"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="nextjs_starter"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# BETTER AUTH CONFIGURATION
# Generate secret using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="your-secret-key-here-change-this"

# Your application URL (change in production)
BETTER_AUTH_URL="http://localhost:3000"

# NODE ENVIRONMENT
NODE_ENV="development"

# NEO OBJECT STORAGE (Biznet Neo — S3-compatible)
# Dapatkan credentials di: https://portal.neo.id → Object Storage
# Dokumentasi: https://www.biznetgio.com/support/object-storage
NEO_S3_ACCESS_KEY="your-neo-access-key"
NEO_S3_SECRET_KEY="your-neo-secret-key"
NEO_S3_BUCKET="nama-bucket-kamu"                          # contoh: haqi-design-files
NEO_S3_ENDPOINT="nos.wjv-1.neo.id"                        # endpoint wilayah Jakarta
NEO_S3_PUBLIC_URL="https://nama-bucket-kamu.nos.wjv-1.neo.id"  # URL publik bucket

# SOKETI (Self-hosted WebSocket)
PUSHER_APP_ID="pos-app"
PUSHER_SECRET="pos-secret"
NEXT_PUBLIC_PUSHER_KEY="pos-key"
NEXT_PUBLIC_PUSHER_HOST="localhost"
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_SCHEME="ws"